PREFIX edtf: <http://id.loc.gov/datatypes/edtf/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    ?uri a skos:Concept, ?type ;
        skos:prefLabel ?prefLabel ;
        skos:altLabel ?altLabel ;
        skos:scopeNote ?scopeNote_nl, ?scopeNote_en ;
        skos:exactMatch ?exactMatch_uri ;
        rdfs:seeAlso ?seeAlso ;
        schema:birthDate ?birthDate_edtf ;
        schema:deathDate ?deathDate_edtf ;
        schema:birthPlace ?birthPlace_uri, ?birthPlace_alternative_nl, ?birthPlace_alternative_en ;
        schema:deathPlace ?deathPlace_uri, ?deathPlace_alternative_nl, ?deathPlace_alternative_en ;
        schema:hasOccupation ?occupation ;
        schema:nationality ?nationality_uri, ?nationality_alternative .
    ?birthPlace_uri schema:name ?birthPlace_name_nl, ?birthPlace_name_en .
    ?deathPlace_uri schema:name ?deathPlace_name_nl, ?deathPlace_name_en .
    ?nationality_named schema:name ?nationality_name .
}
# The dates and places below stay in OPTIONALs rather than becoming UNION branches, because the
# scopeNote BINDs combine ?birthDate, ?deathDate and the subquery’s aggregates and a UNION would
# leave one side of that expression unbound. See “One UNION branch per multi-valued property” in the
# catalog README. The properties that nothing combines are UNION branches, further down.
WHERE {
    # For example:
    # Rembrandt: <https://data.rkd.nl/artists/66219>
    # Vincent van Gogh: <https://data.rkd.nl/artists/32439>
    VALUES ?uri { ?uris }
    {
        SELECT ?uri ?type
            (GROUP_CONCAT(DISTINCT ?schema_description; separator="; ") as ?descriptions)
            (GROUP_CONCAT(DISTINCT ?additionalType_nl; separator=", ") as ?additionalTypes_nl)
            (GROUP_CONCAT(DISTINCT ?additionalType_en; separator=", ") as ?additionalTypes_en)
            (COUNT(DISTINCT ?birthPlace_iri) AS ?birthPlaceCount)
            (COUNT(DISTINCT ?deathPlace_iri) AS ?deathPlaceCount)
            (COUNT(DISTINCT ?nationality_iri) AS ?nationalityCount)
            (SAMPLE(?nationality_iri) AS ?nationality_sample)
            ?birthPlace_nl
            ?birthPlace_en
            ?deathPlace_nl
            ?deathPlace_en
        WHERE {
            ?uri a ?type .
            VALUES ?type { schema:Person schema:Organization }

            OPTIONAL { ?uri schema:description ?schema_description . }

            # How many places and nationalities the source states, to tell one from a list of
            # alternatives below; the nationality IRI itself is sampled, which is exact when there is
            # one. Its literals are not projected here: every non-aggregated variable this subquery
            # projects multiplies its rows, and a person with six nationalities in two languages
            # would take 36 rows out of the LIMIT that is meant to count persons.
            OPTIONAL { ?uri schema:birthPlace ?birthPlace_iri . FILTER(isIRI(?birthPlace_iri)) }
            OPTIONAL { ?uri schema:deathPlace ?deathPlace_iri . FILTER(isIRI(?deathPlace_iri)) }
            OPTIONAL { ?uri schema:nationality ?nationality_iri . FILTER(isIRI(?nationality_iri)) }

            OPTIONAL {
                ?uri schema:birthPlace ?birthPlace_nl .
                FILTER(langMatches(lang(?birthPlace_nl), "nl"))
            }
            OPTIONAL {
                ?uri schema:birthPlace ?birthPlace_en .
                FILTER(langMatches(lang(?birthPlace_en), "en"))
            }

            OPTIONAL {
                ?uri schema:deathPlace ?deathPlace_nl .
                FILTER(langMatches(lang(?deathPlace_nl), "nl"))
            }
            OPTIONAL {
                ?uri schema:deathPlace ?deathPlace_en .
                FILTER(langMatches(lang(?deathPlace_en), "en"))
            }

            OPTIONAL {
                ?uri schema:additionalType ?additionalType_nl .
                FILTER(langMatches(lang(?additionalType_nl), "nl"))
            }
            OPTIONAL {
                ?uri schema:additionalType ?additionalType_en .
                FILTER(langMatches(lang(?additionalType_en), "en"))
            }
        }
        #LIMIT#
    }

    OPTIONAL { ?uri schema:name ?prefLabel . }
    OPTIONAL { ?uri schema:birthDate ?birthDate . }
    OPTIONAL { ?uri schema:deathDate ?deathDate . }

    # RKD states each of these several times per person – Rembrandt has five alternate names, seven
    # alignments and seven occupations – so each gets its own UNION branch rather than an OPTIONAL,
    # which would multiply them into one row per combination.
    #
    # RKD publishes a birth place, an occupation and a nationality twice over: as an IRI into its own
    # thesaurus, and as Dutch and English literals beside it, with nothing pairing the two. The
    # thesaurus itself is not in this endpoint. A birth or death place, and a nationality, is
    # single-valued for most persons, and then the IRI is named with the literals from the subquery
    # above; see the BINDs below for the rest. Occupations are too often multi-valued for that, so
    # they are returned as the literals alone, each a role by name.
    # An organisation has an additionalType too – ‘museum’ – which is not an occupation, so those
    # two branches are for persons only.
    #
    # The group is not an OPTIONAL, and its first branch repeats a pattern the term already matches,
    # for the reasons the README gives: an OPTIONAL stops Virtuoso applying the patterns outside the
    # group to the branches, and without the first branch a term with none of the properties drops
    # out of the result.
    {
        { ?uri a ?type . }
        UNION { ?uri schema:alternateName ?altLabel . }
        UNION { ?uri rdfs:seeAlso ?exactMatch_uri . }
        UNION { ?uri schema:birthPlace ?birthPlace_uri . FILTER(isIRI(?birthPlace_uri)) }
        UNION { ?uri schema:deathPlace ?deathPlace_uri . FILTER(isIRI(?deathPlace_uri)) }
        UNION { ?uri a schema:Person ; schema:additionalType ?occupation . FILTER(isLiteral(?occupation)) }
        UNION { ?uri a schema:Person ; schema:nationality ?nationality_uri . FILTER(isIRI(?nationality_uri)) }
        UNION { ?uri a schema:Person ; schema:nationality ?nationality_literal . FILTER(isLiteral(?nationality_literal)) }
    }

    # A birth or death place, and a nationality, is stated twice, as a thesaurus IRI and as Dutch
    # and English literals, with nothing pairing the two, and the thesaurus is not in this endpoint.
    # For all but 476 persons there is one place, and for 94% one nationality, and then the IRI takes
    # the literals as its names. The rest are alternatives the literature disagrees on – ‘geboorteplaats
    # onzeker’, Cortona or Siena – so naming each IRI with every literal would turn ‘Cortona or Siena’
    # into ‘Cortona, also called Siena’. Those come out as the IRIs unnamed and the literals as entities
    # by name alone, as does a place or nationality stated by literals only. An unbound variable in
    # the IF makes the BIND fail, which leaves the variable unbound and the triple unconstructed.
    BIND(IF(?birthPlaceCount = 1, ?birthPlace_nl, ?noValue) AS ?birthPlace_name_nl)
    BIND(IF(?birthPlaceCount = 1, ?birthPlace_en, ?noValue) AS ?birthPlace_name_en)
    BIND(IF(?birthPlaceCount != 1, ?birthPlace_nl, ?noValue) AS ?birthPlace_alternative_nl)
    BIND(IF(?birthPlaceCount != 1, ?birthPlace_en, ?noValue) AS ?birthPlace_alternative_en)
    BIND(IF(?deathPlaceCount = 1, ?deathPlace_nl, ?noValue) AS ?deathPlace_name_nl)
    BIND(IF(?deathPlaceCount = 1, ?deathPlace_en, ?noValue) AS ?deathPlace_name_en)
    BIND(IF(?deathPlaceCount != 1, ?deathPlace_nl, ?noValue) AS ?deathPlace_alternative_nl)
    BIND(IF(?deathPlaceCount != 1, ?deathPlace_en, ?noValue) AS ?deathPlace_alternative_en)
    # The nationality literals arrive on rows of their own UNION branch, with the sampled IRI from
    # the subquery beside them, so a single nationality is named from those rows.
    BIND(IF(?nationalityCount = 1, ?nationality_sample, ?noValue) AS ?nationality_named)
    BIND(IF(?nationalityCount = 1, ?nationality_literal, ?noValue) AS ?nationality_name)
    BIND(IF(?nationalityCount != 1, ?nationality_literal, ?noValue) AS ?nationality_alternative)

    # RKD’s dates are EDTF Level 0 as published: a plain ISO 8601 date at whatever precision it
    # knows, or an interval such as ‘1606-07-15/1607’. An interval is more than a schema:Date, so it
    # is typed as EDTF to say so; a plain date needs no type. An unbound date leaves the BIND unbound.
    BIND(IF(CONTAINS(STR(?birthDate), "/"), STRDT(STR(?birthDate), edtf:EDTF), ?birthDate) AS ?birthDate_edtf)
    BIND(IF(CONTAINS(STR(?deathDate), "/"), STRDT(STR(?deathDate), edtf:EDTF), ?deathDate) AS ?deathDate_edtf)

    BIND(
        STRLANG(
            CONCAT(
                IF(BOUND(?birthDate) || STRLEN(?birthPlace_nl) > 0,
                    CONCAT(
                        IF(BOUND(?birthDate), CONCAT(?birthDate, " "), ""),
                        IF(STRLEN(?birthPlace_nl) > 0, CONCAT("(", ?birthPlace_nl, ") "), ""),
                        IF(BOUND(?deathDate) || STRLEN(?deathPlace_nl) > 0," - "," – ; ")),
                        ""
                    ),
                IF(BOUND(?deathDate) || STRLEN(?deathPlace_nl) > 0,
                    CONCAT(
                        IF(BOUND(?birthDate) || STRLEN(?birthPlace_nl) > 0, "", "– "),
                        IF(BOUND(?deathDate), CONCAT(?deathDate, " "), ""),
                        IF(STRLEN(?deathPlace_nl) > 0, CONCAT("(", ?deathPlace_nl, ")"), ""),
                        "; "),
                        ""
                    ),
                IF(STRLEN(?additionalTypes_nl) > 0, CONCAT(?additionalTypes_nl, ". "), ""),
                IF(STRLEN(?descriptions) > 0, CONCAT(?descriptions, ". "), "")
            ),
            "nl"
        ) as ?scopeNote_nl
    )
    BIND(
        STRLANG(
            CONCAT(
                IF(BOUND(?birthDate) || STRLEN(?birthPlace_en) > 0,
                    CONCAT(
                        IF(BOUND(?birthDate), CONCAT(?birthDate, " "), ""),
                        IF(STRLEN(?birthPlace_en) > 0, CONCAT("(", ?birthPlace_en, ") "), ""),
                        IF(BOUND(?deathDate) || STRLEN(?deathPlace_en) >0, " - ", " – ; ")),
                        ""
                    ),
                IF(BOUND(?deathDate) || STRLEN(?deathPlace_en) > 0,
                    CONCAT(
                        IF(BOUND(?birthDate) || STRLEN(?birthPlace_en) > 0, "", "– "),
                        IF(BOUND(?deathDate), CONCAT(?deathDate, " "), ""),
                        IF(STRLEN(?deathPlace_en) > 0, CONCAT("(", ?deathPlace_en, ")"), ""),
                        "; "),
                        ""
                    ),
                IF(STRLEN(?additionalTypes_en) > 0, CONCAT(?additionalTypes_en, ". "), ""),
                IF(STRLEN(?descriptions) > 0, CONCAT(?descriptions, ". "), "")
            ),
            "en"
        ) as ?scopeNote_en
    )
    BIND(STRAFTER(STR(?uri), "https://data.rkd.nl/artists/") AS ?identifier)
    BIND(IRI(CONCAT("https://rkd.nl/explore/artists/", ?identifier)) AS ?seeAlso)
}
