PREFIX aat: <http://vocab.getty.edu/aat/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX gvp: <http://vocab.getty.edu/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX skosxl: <http://www.w3.org/2008/05/skos-xl#>

CONSTRUCT {
    ?uri a skos:Concept ;
        skos:prefLabel ?prefLabel ;
        skos:altLabel ?altLabel ;
        skos:scopeNote ?scopeNote ;
        rdfs:seeAlso ?rdfs_seeAlso ;
        skos:broader ?broader_uri ;
        skos:narrower ?narrower_uri ;
        skos:exactMatch ?exactMatch_uri .
    ?broader_uri skos:prefLabel ?broader_prefLabel .
    ?narrower_uri skos:prefLabel ?narrower_prefLabel .
}
WHERE {
    # For example:
    # Bicycles: <http://vocab.getty.edu/aat/300212636>
    # Wars: <http://vocab.getty.edu/aat/300055314>
    VALUES ?uri { ?uris }
    FILTER NOT EXISTS { ?uri a gvp:GuideTerm }
    VALUES ?language {
        aat:300388256 # Dutch
        aat:300388277 # English
    }

    # Only terms with a Dutch or English label, as before; the labels themselves come from the
    # first branch below.
    ?uri skosxl:prefLabel [
        dcterms:language ?language ; # Faster than FILTER(langMatches(...): https://vocab.getty.edu/queries#Find_Terms_by_Language_Tag
        skosxl:literalForm ?prefLabel
    ]

    # One UNION branch per independently multi-valued property, and not an OPTIONAL group:
    # see “One UNION branch per multi-valued property” in the catalog README.
    # The branches share the ?language values above rather than each declaring their own, which is
    # also why none of them may sit in an OPTIONAL here: GraphDB stops applying the outer VALUES to
    # a branch inside one and answers with labels in every language Getty holds.
    {
        {
            ?uri skosxl:prefLabel [
                dcterms:language ?language ; # Faster than FILTER(langMatches(...): https://vocab.getty.edu/queries#Find_Terms_by_Language_Tag
                skosxl:literalForm ?prefLabel
            ]
        }
        UNION {
            ?uri skosxl:altLabel [
                dcterms:language ?language ;
                skosxl:literalForm ?altLabel
            ]
        }
        UNION {
            ?uri skos:scopeNote [
                dcterms:language ?language ;
                rdf:value ?scopeNote
            ]
        }
        UNION {
            ?uri rdfs:seeAlso ?rdfs_seeAlso
        }
        UNION {
            ?uri gvp:broaderPreferred ?broader_uri .
            ?broader_uri skosxl:prefLabel [
                dcterms:language ?language ;
                skosxl:literalForm ?broader_prefLabel
            ]
        }
        UNION {
            ?uri skos:narrower ?narrower_uri .
            ?narrower_uri skosxl:prefLabel [
                dcterms:language ?language ;
                skosxl:literalForm ?narrower_prefLabel
            ]
        }
        UNION {
            ?uri skos:exactMatch ?exactMatch_uri . # Has no labels.
            FILTER(?exactMatch_uri != ?uri) # Exclude self-reference.
        }
    }
}
LIMIT 10000
