PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    ?uri a skos:Concept ;
        skos:prefLabel ?prefLabel ;
        skos:altLabel ?altLabel ;
        skos:scopeNote ?description .
}
WHERE {
    # For example:
    # Some entity (e.g. a painting): <http://www.wikidata.org/entity/Q185255>
    # Person: <http://www.wikidata.org/entity/Q2696551>
    # Place: <http://www.wikidata.org/entity/Q727>
    # Street: <http://www.wikidata.org/entity/Q19573969>
    VALUES ?uri { ?uris }

    # ‘mul’ is Wikidata’s ‘default for all languages’ label.
    ?uri rdfs:label ?prefLabel .
    FILTER(LANG(?prefLabel) IN ("nl", "en", "mul"))

    # One UNION branch per independently multi-valued property, and not an OPTIONAL group:
    # see “One UNION branch per multi-valued property” in the catalog README.
    {
        { ?uri rdfs:label ?prefLabel }
        UNION {
            ?uri skos:altLabel ?altLabel .
            FILTER(LANG(?altLabel) IN ("nl", "en", "mul"))
        }
        UNION {
            ?uri schema:description ?description .
            FILTER(LANG(?description) = "nl" || LANG(?description) = "en")
        }
    }
}
LIMIT 10000
