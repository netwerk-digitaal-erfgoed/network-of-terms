PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    ?uri a skos:Concept ;
        skos:prefLabel ?prefLabel ;
        skos:altLabel ?altLabel ;
        skos:scopeNote ?description .
}
WHERE {
    # For example:
    # Some entity (e.g. a painting): <http://www.wikidata.org/entity/Q185255>
    # Person: <http://www.wikidata.org/entity/Q2696551>
    # Place: <http://www.wikidata.org/entity/Q727>
    # Street: <http://www.wikidata.org/entity/Q19573969>
    VALUES ?uri { ?uris }

    # ‘mul’ is Wikidata’s ‘default for all languages’ label.
    ?uri rdfs:label ?prefLabel .
    FILTER(LANG(?prefLabel) IN ("nl", "en", "mul"))

    # Each property below is independently multi-valued, so use UNION (one branch per property)
    # instead of OPTIONAL to prevent a cross-product. Besides being far slower, the cross-product
    # multiplies rows past the LIMIT below, which drops whole terms from a multi-term lookup.
    #
    # The group must not be an OPTIONAL: Virtuoso and GraphDB then stop applying the patterns
    # outside it to the branches, and answer with the wrong rows or none at all. The first
    # branch repeats a pattern the term already matches, so the group matches every term even
    # when it carries none of the properties below.
    {
        { ?uri rdfs:label ?prefLabel }
        UNION {
            ?uri skos:altLabel ?altLabel .
            FILTER(LANG(?altLabel) IN ("nl", "en", "mul"))
        }
        UNION {
            ?uri schema:description ?description .
            FILTER(LANG(?description) = "nl" || LANG(?description) = "en")
        }
    }
}
LIMIT 10000
