PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    ?uri a skos:Concept ;
        skos:prefLabel ?schema_name ;
        skos:altLabel ?schema_alternateName ;
        skos:hiddenLabel ?hiddenLabel;
        skos:scopeNote ?schema_description, ?scopeNote .
}
WHERE {
    # For example:
    # Huize Boschlust: <https://data.brabantcloud.nl/id/ark:15052/62dd4e81-b7d6-4fc2-9473-5f4b17226105>
    # Mariaklooster: <https://data.brabantcloud.nl/id/ark:15052/0963f6bb-4b84-4e37-a087-31bbabfda4bb>
    # Abdij van Binderen: <https://data.brabantcloud.nl/id/ark:15052/991b1709-527a-43c5-a96f-3366bb0e61c8>
    VALUES ?uri { ?uris }

    ?uri a schema:LandmarksOrHistoricalBuildings .
    # Each property below is independently multi-valued, so use UNION (one branch per property)
    # instead of OPTIONAL to prevent a cross-product. Besides being far slower, the cross-product
    # multiplies rows past the LIMIT below, which drops whole terms from a multi-term lookup.
    #
    # The group must not be an OPTIONAL: Virtuoso and GraphDB then stop applying the patterns
    # outside it to the branches, and answer with the wrong rows or none at all. The first
    # branch repeats a pattern the term already matches, so the group matches every term even
    # when it carries none of the properties below.
    {
        { ?uri a schema:LandmarksOrHistoricalBuildings }
        UNION { ?uri schema:name ?schema_name }
        UNION { ?uri schema:alternateName ?schema_alternateName }
        UNION { ?uri schema:description ?schema_description }
        UNION { ?uri skos:hiddenLabel ?hiddenLabel }
        UNION { ?uri skos:scopeNote ?scopeNote }
    }
}
LIMIT 10000
