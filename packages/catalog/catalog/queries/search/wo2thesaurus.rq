PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    ?uri a skos:Concept ;
        skos:prefLabel ?prefLabel ;
        skos:altLabel ?altLabel ;
        skos:hiddenLabel ?hiddenLabel ;
        skos:scopeNote ?scopeNote ;
        skos:broader ?broader_uri ;
        skos:narrower ?narrower_uri ;
        skos:exactMatch ?exactMatch_uri .
    ?broader_uri skos:prefLabel ?broader_prefLabel .
    ?narrower_uri skos:prefLabel ?narrower_prefLabel .
}
WHERE {
    {
        SELECT ?uri WHERE {
            ?uri ?predicate ?label .
            # Exclude terms that are *only* in 'Technische Lijsten', but keep terms that are also in other schemes
            FILTER NOT EXISTS {
              ?uri skos:inScheme <https://data.niod.nl/WO2_Thesaurus/11183> .
              FILTER NOT EXISTS {
                ?uri skos:inScheme ?otherScheme .
                FILTER(?otherScheme != <https://data.niod.nl/WO2_Thesaurus/11183>)
              }
            }
            VALUES ?predicate { skos:prefLabel skos:altLabel }
            FILTER(LANG(?label) = "nl")
            FILTER(CONTAINS(LCASE(?label), LCASE(?query)))
        }

        #LIMIT#
    }
    # One UNION branch per independently multi-valued property, and not an OPTIONAL group:
    # see “One UNION branch per multi-valued property” in the catalog README.
    {
        { ?uri a skos:Concept }
        UNION {
            ?uri skos:prefLabel ?prefLabel .
            FILTER(LANG(?prefLabel) = "nl" )
        }
        UNION {
            ?uri skos:scopeNote ?scopeNote .
            FILTER(LANG(?scopeNote) = "nl")
        }
        UNION {
            ?uri skos:altLabel ?altLabel .
            FILTER(LANG(?altLabel) = "nl")
        }
        UNION {
            ?uri skos:hiddenLabel ?hiddenLabel .
            FILTER(LANG(?hiddenLabel) = "nl")
        }
        UNION {
            ?uri skos:broader ?broader_uri .
            ?broader_uri skos:prefLabel ?broader_prefLabel .
            FILTER(LANG(?broader_prefLabel) = "nl")
        }
        UNION {
            ?uri skos:narrower ?narrower_uri .
            ?narrower_uri skos:prefLabel ?narrower_prefLabel .
            FILTER(LANG(?narrower_prefLabel) = "nl")
        }
        UNION { ?uri skos:exactMatch ?exactMatch_uri } # Has no labels.
    }
}
