PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    ?uri a skos:Concept ;
        skos:prefLabel ?rdfs_label ;
        skos:altLabel ?schema_name ;
        skos:altLabel ?schema_alternateName ;
        skos:scopeNote ?scopeNote ;
        skos:exactMatch ?exactMatch_uri .
}
WHERE {
    {
        SELECT ?uri ?rdfs_label WHERE {
            ?uri schema:mainEntityOfPage/schema:isPartOf <http://data.bibliotheken.nl/id/dataset/stcn/printers> ;
                schema:additionalType <http://www.productontology.org/id/Printer_%28publishing%29> ;   # Select printers.
                rdfs:label ?rdfs_label .

            ?uri ?predicate ?label .
            VALUES ?predicate { rdfs:label schema:name schema:alternateName }
            ?label <bif:contains> ?virtuosoQuery .
        }
        #LIMIT#
    }
    # STCN defines multiple URIs for the same printer.
    # The distinction between these URIs is based on the place where the printer lived and worked.
    # See for example "Plantijn"
    # http://data.bibliotheken.nl/id/thes/p075556251 for Plantijn working in Leiden
    # http://data.bibliotheken.nl/id/thes/p338012834 for Plantijn working in Antwerp
    # The original source (STCN) shows also a time period, this data currently not available in the LOD version.
    # Each property below is independently multi-valued, so use UNION (one branch per property)
    # instead of OPTIONAL to prevent a cross-product: a term then costs the sum of its values in
    # rows rather than their product. Besides being far slower, the cross-product of a result set
    # of richly-linked terms runs into whatever row limit the endpoint applies, which silently
    # truncates the labels of their related terms.
    #
    # The group must not be an OPTIONAL: Virtuoso and GraphDB then stop applying the patterns
    # outside it to the branches, and answer with the wrong rows or none at all. The first
    # branch repeats a pattern the term already matches, so the group matches every term even
    # when it carries none of the properties below.
    {
        { ?uri schema:mainEntityOfPage/schema:isPartOf <http://data.bibliotheken.nl/id/dataset/stcn/printers> }
        UNION { ?uri schema:location/schema:address/schema:addressLocality ?scopeNote }
        UNION { ?uri schema:name ?schema_name }
        UNION { ?uri schema:alternateName ?schema_alternateName }
        UNION { ?uri schema:sameAs ?exactMatch_uri } # Has no labels.
    }
}
