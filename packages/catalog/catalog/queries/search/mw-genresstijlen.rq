PREFIX muziekweb: <https://data.muziekweb.nl/vocab/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    ?uri a skos:Concept ;
        skos:prefLabel ?rdfs_label ;
        skos:scopeNote ?rdfs_comment ;
        skos:broader ?broader_uri ;
        skos:narrower ?narrower_uri ;
        skos:exactMatch ?exactMatch_uri .
    ?broader_uri skos:prefLabel ?broader_prefLabel .
    ?narrower_uri skos:prefLabel ?narrower_prefLabel .
}
WHERE {
    {
        SELECT DISTINCT ?uri WHERE {
            ?uri a muziekweb:Genre ;
                rdfs:label ?rdfs_label .
            ?rdfs_label <bif:contains> ?virtuosoQuery .
        }
        #LIMIT#
    }

    ?uri  rdfs:label ?rdfs_label .

    # Each property below is independently multi-valued, so use UNION (one branch per property)
    # instead of OPTIONAL to prevent a cross-product: a term then costs the sum of its values in
    # rows rather than their product. Besides being far slower, the cross-product of a result set
    # of richly-linked terms runs into whatever row limit the endpoint applies, which silently
    # truncates the labels of their related terms.
    #
    # The group must not be an OPTIONAL: Virtuoso and GraphDB then stop applying the patterns
    # outside it to the branches, and answer with the wrong rows or none at all. The first
    # branch repeats a pattern the term already matches, so the group matches every term even
    # when it carries none of the properties below.
    {
        { ?uri a muziekweb:Genre }
        UNION {
            ?uri skos:broader ?broader_uri .
            ?broader_uri rdfs:label ?broader_prefLabel
        }
        UNION {
            ?uri skos:narrower ?narrower_uri .
            ?narrower_uri rdfs:label ?narrower_prefLabel
        }
        UNION { ?uri rdfs:comment ?rdfs_comment }
        UNION { ?uri owl:sameAs ?exactMatch_uri } # Has no labels.
    }
}

