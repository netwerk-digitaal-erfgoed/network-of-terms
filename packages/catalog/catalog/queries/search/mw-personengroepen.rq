PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    ?uri a skos:Concept ;
        skos:prefLabel ?prefLabel ;
        skos:altLabel ?altLabel ;
        skos:hiddenLabel ?hiddenLabel ;
        skos:scopeNote ?schema_description ;
        skos:exactMatch ?exactMatch_uri .
}
WHERE {
    {
        SELECT DISTINCT ?uri WHERE {
            ?uri a schema:MusicGroup ;
                ?predicate ?label .
            VALUES ?predicate { skos:prefLabel skos:altLabel }
            ?label <bif:contains> ?virtuosoQuery .
        }
        #LIMIT#
    }

    # One UNION branch per independently multi-valued property, and not an OPTIONAL group:
    # see “One UNION branch per multi-valued property” in the catalog README.
    {
        { ?uri a schema:MusicGroup }
        UNION { ?uri skos:prefLabel ?prefLabel }
        UNION { ?uri skos:altLabel ?altLabel }
        UNION { ?uri skos:hiddenLabel ?hiddenLabel }
        UNION { ?uri schema:description ?schema_description }
        UNION { ?uri owl:sameAs ?exactMatch_uri } # Has no labels.
    }
}
