PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX bengthes: <http://data.beeldengeluid.nl/schema/thes#>
PREFIX text: <http://jena.apache.org/text#>
PREFIX vrank: <http://purl.org/voc/vrank#>

CONSTRUCT {
    ?uri a skos:Concept ;
        skos:prefLabel ?prefLabel ;
        skos:altLabel ?altLabel ;
        skos:hiddenLabel ?hiddenLabel ;
        skos:scopeNote ?scopeNote ;
        skos:broader ?broader_uri ;
        skos:narrower ?narrower_uri ;
        skos:related ?related_uri ;
        skos:exactMatch ?exactMatch_uri ;
        vrank:simpleRank ?score .
    ?broader_uri skos:prefLabel ?broader_prefLabel .
    ?narrower_uri skos:prefLabel ?narrower_prefLabel .
    ?related_uri skos:prefLabel ?related_prefLabel .
    ?exactMatch_uri skos:prefLabel ?exactMatch_prefLabel .
}
WHERE {
    {
        SELECT ?uri (MAX(?sc) as ?score) {
            (?uri ?sc) text:query (skos:prefLabel skos:altLabel skos:hiddenLabel ?query) .
            ?uri skos:inScheme ?datasetUri ;
                bengthes:status ?status .
            FILTER(?status IN ('approved', 'candidate'))
        }
        GROUP BY ?uri
        #LIMIT#
    }

    # Each property below is independently multi-valued, so use UNION (one branch per property)
    # instead of OPTIONAL to prevent a cross-product: a term then costs the sum of its values in
    # rows rather than their product. Besides being far slower, the cross-product of a result set
    # of richly-linked terms runs into whatever row limit the endpoint applies, which silently
    # truncates the labels of their related terms.
    #
    # The group must not be an OPTIONAL: Virtuoso and GraphDB then stop applying the patterns
    # outside it to the branches, and answer with the wrong rows or none at all. The first
    # branch repeats a pattern the term already matches, so the group matches every term even
    # when it carries none of the properties below.
    {
        { ?uri skos:inScheme ?datasetUri }
        UNION {
            ?uri skos:prefLabel ?prefLabel .
            FILTER(LANG(?prefLabel) = "nl" )
        }
        UNION {
            ?uri skos:altLabel ?altLabel .
            FILTER(LANG(?altLabel) = "nl")
        }
        UNION {
            ?uri skos:hiddenLabel ?hiddenLabel .
            FILTER(LANG(?hiddenLabel) = "nl")
        }
        UNION {
            ?uri skos:scopeNote ?scopeNote .
            FILTER(LANG(?scopeNote) = "nl")
        }
        UNION {
            ?uri skos:broader ?broader_uri .
            ?broader_uri skos:prefLabel ?broader_prefLabel .
            FILTER(LANG(?broader_prefLabel) = "nl")
        }
        UNION {
            ?uri skos:narrower ?narrower_uri .
            ?narrower_uri skos:prefLabel ?narrower_prefLabel .
            FILTER(LANG(?narrower_prefLabel) = "nl")
        }
        UNION {
            ?uri skos:related ?related_uri .
            ?related_uri skos:prefLabel ?related_prefLabel .
            FILTER(LANG(?related_prefLabel) = "nl")
        }
        UNION {
            ?uri skos:exactMatch ?exactMatch_uri .
            ?exactMatch_uri skos:prefLabel ?exactMatch_prefLabel .
            FILTER(LANG(?exactMatch_prefLabel) = "nl")
        }
    }
}
