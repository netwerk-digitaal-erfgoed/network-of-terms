PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    ?uri a skos:Concept, ?type ;
        skos:prefLabel ?schema_name ;
        skos:altLabel ?schema_alternateName ;
        skos:scopeNote ?schema_description .
}
WHERE {
    {
        SELECT * WHERE {
            ?uri a ?type ;
                ?predicate ?label .
            VALUES ?type { schema:Person schema:Organization }
            VALUES ?predicate { schema:name schema:alternateName }
            FILTER(CONTAINS(LCASE(?label), LCASE(?query)))
        }
        #LIMIT#
    }

    # One UNION branch per independently multi-valued property, and not an OPTIONAL group:
    # see “One UNION branch per multi-valued property” in the catalog README.
    {
        { ?uri a ?type }
        UNION { ?uri schema:name ?schema_name }
        UNION { ?uri schema:alternateName ?schema_alternateName }
        UNION { ?uri schema:description ?schema_description }
    }
}
