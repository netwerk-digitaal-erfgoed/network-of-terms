@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix vrank: <http://purl.org/voc/vrank#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.com/resources/artwork>
    a skos:Concept ;
    skos:prefLabel "Nachtwacht"@nl, "The Night Watch"@en ;
    skos:altLabel "Nachtwacht alt"@nl, "Night Watch alt"@en ;
    skos:scopeNote "One of the most famous Dutch paintings"@en ;
    skos:hiddenLabel "art" ;
    skos:broader <https://example.com/resources/2> ;
    skos:related <https://example.com/resources/painter> ,
        <https://example.com/resources/painting> ,
        <https://example.com/resources/art> ;
    skos:exactMatch <https://example.com/resources/match> ;
    skos:ignored "Not used by Network of Terms" ;
    rdfs:seeAlso <https://example.com/html/artwork> ;
    vrank:simpleRank 18.0 .

<https://example.com/resources/painting>
    a <http://www.w3.org/2008/05/skos#Concept> ;
    skos:altLabel
        "painted things that can be beautiful"@en ,
        "another altLabel"@en ,
        "mooie geschilderde dingen"@nl ,
        "en nog meer"@nl ;
    skos:related <https://example.com/resources/art> ;
    skos:broader <https://example.com/resources/art> .

<https://example.com/resources/painter>
    a <http://www.w3.org/2008/05/skos#Concept> ;
    skos:prefLabel "Rembrandt"@en ;
    vrank:simpleRank 20.5 .

<https://example.com/resources/art>
    a skos:Concept ;
    skos:prefLabel "All things art"@en, "Kunstige dingen" ; # last value is fallback and has no language tag on purpose
    skos:altLabel "Art"@en ;
    skos:narrower <https://example.com/resources/artwork> .

<https://example.com/resources/alphabet>
    a skos:Concept ;
    skos:altLabel "Resource without prefLabel"@en .

<https://example.com/resources/match>
    skos:prefLabel "Exact match"@en .

<https://example.com/resources/photographer>
    a skos:Concept, schema:Person ;
    # Wikidata-style ‘default for all languages’ label; see issue #1884.
    skos:prefLabel "Marion Michelle Koblitz"@mul .

# A person in the shape that sources construct. The dates are EDTF strings, typed as such where
# they say more than a plain ISO 8601 date. The birth place is an IRI from the source’s own
# vocabulary, named by that vocabulary; the occupations and nationality are names alone, which is
# all RKDartists can pair with a person.
<https://example.com/resources/rembrandt>
    a skos:Concept, schema:Person ;
    skos:prefLabel "Rembrandt"@nl ;
    skos:altLabel "Rembrandt van Rijn"@nl ;
    schema:givenName "Rembrandt" ;
    schema:familyName "van Rijn" ;
    schema:birthDate "1606-07-15/1607"^^<http://id.loc.gov/datatypes/edtf/EDTF> ;
    schema:deathDate "1669-10-04" ;
    schema:birthPlace <https://example.com/places/leiden> ;
    schema:deathPlace "Amsterdam (stad)"@nl, "Amsterdam (city)"@en ;
    # Occupations the source only names become roles named by them; a schema:Role node it
    # constructs is read for its occupation, name and period, the way Schema.org reads one.
    schema:hasOccupation "schilder"@nl, "painter"@en, "etser"@nl, "etcher"@en,
        <https://example.com/resources/rembrandt#role-1>, <https://example.com/resources/rembrandt#role-2> ;
    schema:nationality "Noord-Nederlands"@nl, "North Netherlandish"@en .

<https://example.com/resources/rembrandt#role-1>
    a schema:Role ;
    schema:hasOccupation <https://example.com/occupations/art-collector> ;
    schema:startDate "1625" ;
    schema:endDate "1669" .

<https://example.com/occupations/art-collector>
    schema:name "kunstverzamelaar"@nl, "art collector"@en .

# A role the source names but does not identify, as RKD’s period of activity.
<https://example.com/resources/rembrandt#role-2>
    a schema:Role ;
    schema:roleName "werkzaam"@nl, "active"@en ;
    schema:startDate "1625" ;
    schema:endDate "1669" .

<https://example.com/places/leiden>
    schema:name "Leiden (stad)"@nl, "Leiden (city)"@en .

# A person whose source states only the split into given and family name, as the NTA does for most
# of its authors, so the node still exists.
<https://example.com/resources/person-only-split-name>
    a skos:Concept, schema:Person ;
    skos:prefLabel "Mulisch, Harry"@nl ;
    schema:givenName "Harry" ;
    schema:familyName "Mulisch" .

# A person whose source names things in English only, which the monolingual API falls back to.
<https://example.com/resources/person-english-only>
    a skos:Concept, schema:Person ;
    skos:prefLabel "Turner, William"@en ;
    schema:nationality "British"@en ;
    schema:hasOccupation "painter"@en .

# A person whose source states an empty date, which is no date, so the node does not exist.
<https://example.com/resources/person-empty-date>
    a skos:Concept, schema:Person ;
    skos:prefLabel "Naamloos"@nl ;
    schema:birthDate "" .

# A person whose source states a birth place and nothing else, so the node still exists.
<https://example.com/resources/person-only-born-somewhere>
    a skos:Concept, schema:Person ;
    skos:prefLabel "Onbekende schilder"@nl ;
    schema:birthPlace <https://example.com/places/leiden> .

# A place in the shape that sources construct: the coordinates and the country hang off a
# schema:geo node, since schema:addressCountry does not have schema:Place in its domain. Its
# prefLabel carries the country suffix that GeoNames appends, which is exactly what schema:name
# does not.
<https://example.com/resources/place>
    a skos:Concept, schema:Place ;
    skos:prefLabel "Maastricht (NL)"@nl ;
    schema:name "Maastricht"@nl, "Maestricht"@en ;
    schema:additionalType <https://www.geonames.org/ontology#P.PPLA> ;
    schema:geo <https://example.com/resources/place#geo> .

# A type from a vocabulary outside the Network of Terms. GeoNames publishes the code IRI bare, but
# a vocabulary that does name its classes has those names picked up – under skos:prefLabel, as the
# GeoNames ontology does, or under schema:name, as others do.
<https://www.geonames.org/ontology#P.PPLA>
    skos:prefLabel "hoofdplaats van een provincie"@nl ;
    schema:name "seat of a first-order administrative division"@en .

<https://example.com/resources/place#geo>
    a schema:GeoCoordinates ;
    schema:latitude "50.84833"^^xsd:float ;
    schema:longitude "5.68889"^^xsd:float ;
    schema:addressCountry "NL" .

# A place whose source publishes unusable coordinates; see the `floatValue` guard in resolvers.ts.
<https://example.com/resources/place-without-coordinates>
    a skos:Concept, schema:Place ;
    skos:prefLabel "Nergenshuizen"@nl ;
    schema:geo <https://example.com/resources/place-without-coordinates#geo> .

<https://example.com/resources/place-without-coordinates#geo>
    a schema:GeoCoordinates ;
    schema:latitude "" ;
    schema:longitude "onbekend" ;
    schema:addressCountry "  " .

# A place that is described but not located, so it gets a `place` node all the same.
<https://example.com/resources/place-without-location>
    a skos:Concept, schema:Place ;
    skos:prefLabel "Rijnland"@nl ;
    schema:name "Rijnland"@nl ;
    # A type whose vocabulary publishes no label, which is what GeoNames does today.
    schema:additionalType <https://www.geonames.org/ontology#H.LK> ;
    schema:geo <https://example.com/resources/place-without-location#geo> .

<https://example.com/resources/place-without-location#geo>
    a schema:GeoCoordinates ;
    schema:addressCountry "NL" .

# A place its source only names. Whether it gets a `place` node must not depend on the language
# the client asked for, so the node survives a request for a language it has no name in.
<https://example.com/resources/place-only-named>
    a skos:Concept, schema:Place ;
    skos:prefLabel "Nergensland"@nl ;
    schema:name "Nergensland"@nl .

# A place that is locatable on one axis only, so it still gets a `place` node. It also keeps the
# flat shape that sources used before the schema:geo node, which is still read as-is.
<https://example.com/resources/place-without-longitude>
    a skos:Concept, schema:Place ;
    skos:prefLabel "Halvewegen"@nl ;
    schema:latitude "53.20139"^^xsd:float ;
    schema:longitude "" .
