{
  "name": "network-of-terms",
  "private": true,
  "workspaces": [
    "./packages/*"
  ],
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@nx/docker": "24.0.2",
    "@nx/esbuild": "24.0.2",
    "@nx/eslint": "24.0.2",
    "@nx/eslint-plugin": "24.0.2",
    "@nx/js": "24.0.2",
    "@nx/vite": "24.0.2",
    "@nx/vitest": "24.0.2",
    "@nx/web": "24.0.2",
    "@rdfjs/types": "2.0.1",
    "@swc-node/core": "1.15.0",
    "@swc-node/register": "1.12.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsonc-eslint-parser": "3.3.0",
    "nodaemon": "0.0.5",
    "nodemon": "3.1.14",
    "nx": "24.0.2",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.3",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "test:coverage": {
        "command": "vitest run",
        "dependsOn": [
          "^build"
        ]
      },
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
